# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_ADDRESS=your-gmail@gmail.com
# Generate at: Google Account → Security → 2-Step Verification → App Passwords
# No quotes, no extra spaces
GMAIL_PASSKEY=xxxx xxxx xxxx xxxx

# ── App URL ───────────────────────────────────────────────────────────────────
# Local:      http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GTM=

# reCAPTCHA v2 (contact form spam protection). Get keys at:
# https://www.google.com/recaptcha/admin
# If left blank, the contact form falls back to a honeypot field + IP rate limiting.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Basic auth for /admin/*. If either is unset, /admin/* returns 404.
ADMIN_USER=
ADMIN_PASSWORD=
